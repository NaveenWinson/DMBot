# Copy to .env.deploy (git-ignored) and fill in. ./deploy.sh injects these into the functions.
# Quote values that contain " #", e.g. KEY="pa #ss"
# Instagram app secret: Meta app > Instagram > API setup with Instagram login (NOT the main App secret; webhooks are signed with this one)
META_APP_SECRET=your-meta-app-secret
# Any long random string (16+ chars); type the same value as "Verify token" in the Meta webhook setup
WEBHOOK_VERIFY_TOKEN=your-long-random-verify-token
# Your Catalyst sign-in email (admin page guard)
ADMIN_EMAIL=you@example.com
# Any long random string (16+ chars); must match the cron's x-cron-secret header
CRON_SECRET=your-long-random-cron-secret
